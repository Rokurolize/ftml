    -webkit-justify-content: center;
       -moz-box-pack: center;
        -ms-flex-pack: center;
            justify-content: center;
    font-size: clamp(0.4845rem, 0.1609rem + 1.6179vw, 0.9375rem);
}

div.class1 {
    -ms-grid-row: 1;
    -ms-grid-column: 1;
    grid-area: class;
    white-space: nowrap;
    padding-right: 1em;
    display: -ms-grid;
    display: grid;
    -webkit-box-pack: center;
    -webkit-justify-content: center;
       -moz-box-pack: center;
        -ms-flex-pack: center;
