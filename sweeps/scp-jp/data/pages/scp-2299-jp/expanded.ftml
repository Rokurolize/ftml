[[module css]]
#header h2 {
    height: 2em;
    width: auto;
    left: 50%;
    transform: translateX(-50%);
    top: calc(50% + (var(--header-h2-font-size) / 2));
    background-position: center center;
}


@media screen and (max-width:56.25rem) {
    #header h2 {
    	top: calc(50% + (var(--header-h1-font-size) / 2));
    }
}
[[/module]]
