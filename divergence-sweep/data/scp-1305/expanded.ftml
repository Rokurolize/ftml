[[div_ class="anom-bar-container item-{$item-number} clear-{$clearance} {$container-class} {$secondary-class} {$disruption-class} {$risk-class} {$american}"]]
    [[div_ class="anom-bar"]]
    	[[div_ class="top-box"]]
    		[[div_ class="top-left-box"]]
    			[[span class="item"]]Item#:[[/span]] [[span class="number"]]{$item-number}[[/span]]
