[[module CSS]]
@import url("https://cdn.jsdelivr.net/gh/Nu-SCPTheme/Black-Highlighter@gh-pages/css/min/normalize.min.css");
@import url("https://cdn.jsdelivr.net/gh/Nu-SCPTheme/Black-Highlighter@gh-pages/css/min/black-highlighter.min.css");

@import url("https://use.typekit.net/inx2jjr.css");

.collapsible-block a {
    text-align: center;
    width: 100%;
    display: inline-block;
}

div.scale {
    /* Classification Colors */
    --woedbar-keter-color: 180, 30, 35;
    --woedbar-euclid-color: 225, 205, 35;
    --woedbar-safe-color: 35, 145, 70;
    --woedbar-thaum-color: 40, 60, 150;
    --woedbar-neutl-color: 127, 127, 127;
    /* Bar Colors */
    --woedbar-lvl1-color: rgba(var(--swatch-menubg-black-color,12, 12, 12),0.1);
    --woedbar-lvl2-color: rgba(var(--swatch-menubg-black-color,12, 12, 12),0.3);
    --woedbar-lvl3-color: rgba(var(--swatch-menubg-black-color,12, 12, 12),0.55);
    --woedbar-lvl4-color: rgba(var(--swatch-menubg-black-color,12, 12, 12),0.75);
    --woedbar-lvl5-color: rgba(var(--swatch-menubg-black-color,12, 12, 12),1);
    --woedbar-lvl6-color: rgba(var(--swatch-primary-bright,140, 25, 26),1);
}

div.scale {
    width: -moz-fit-content;
    width: -webkit-fit-content;
    width: fit-content;
    max-width: 98vw;
    margin: 0 auto;
    padding: 0;
    border: none;
    display: -ms-grid;
    display: grid;
        grid-template-areas:
    	"class classimage item";
    -ms-grid-columns: 1.25fr auto 1.75fr;
    grid-template-columns: 1.25fr auto 1.75fr;
    -ms-grid-rows: minmax(3em,5em);
    grid-template-rows: minmax(3em,5em);
    -webkit-box-align: stretch;
    -webkit-align-items: stretch;
       -moz-box-align: stretch;
        -ms-flex-align: stretch;
            align-items: stretch;
    -webkit-box-pack: center;
    -webkit-justify-content: center;
       -moz-box-pack: center;
        -ms-flex-pack: center;
            justify-content: center;
    font-size: clamp(0.4845rem, 0.1609rem + 1.6179vw, 0.9375rem);
}

div.class1 {
    -ms-grid-row: 1;
    -ms-grid-column: 1;
    grid-area: class;
    white-space: nowrap;
    padding-right: 1em;
    display: -ms-grid;
    display: grid;
    -webkit-box-pack: center;
    -webkit-justify-content: center;
       -moz-box-pack: center;
        -ms-flex-pack: center;
            justify-content: center;
        grid-template-areas: 
    	"."
    	"leveltxt" 
    	"classtxt"
    	"." ;
    -ms-grid-rows: 
    	auto
    	min-content
    	min-content
    	auto;
    grid-template-rows: 
    	auto
    	-webkit-min-content
    	-webkit-min-content
    	auto;
    grid-template-rows: 
    	auto
    	min-content
    	min-content
    	auto;
}

div.class1>div {
    color: rgb(var(--swatch-menubg-dark-color, 12, 12, 12));
    font-family: rift, sans-serif, Arial, "游明朝", YuMincho, "ヒラギノ明朝 ProN W3", "Hiragino Mincho ProN", "HG明朝E", "ＭＳ Ｐ明朝", "ＭＳ 明朝", 'Noto Serif KR', serif;
    font-size: 2.90em;
    line-height: 0.9em;
}

div.class1 .base:nth-of-type(1) {
    display: none;
}

div.class1 .base:nth-of-type(2) {
    display: inline;
}

div.class1 .CN:nth-of-type(1) {
    display: inline;
}

div.class1 .CN:nth-of-type(2) {
    display: none;
}

div.class1 .false:nth-of-type(1) {
    display: none !important;
}

div.class1 .false:nth-of-type(2) {
    display: inline !important;
}

div.level-text {
    -ms-grid-row: 2;
    -ms-grid-column: 1;
    grid-area: leveltxt;
}

div.class-text {
    -ms-grid-row: 3;
    -ms-grid-column: 1;
    grid-area: classtxt;
}

div.class1image {
    -ms-grid-row: 1;
    -ms-grid-column: 2;
    display: -webkit-box;
    display: -webkit-flex;
    display: -moz-box;
    display: -ms-flexbox;
    display: flex;
    grid-area: classimage;
    -webkit-box-align: center;
    -webkit-align-items: center;
       -moz-box-align: center;
        -ms-flex-align: center;
            align-items: center;
    overflow: hidden;
    margin: 0 0.6em 0 0;
    padding-right: 0.6em;
}

/* middle images */
div.classified-bar {
    position: relative;
    -webkit-mask-image: url("data:image/svg+xml,%3C%3Fxml version='1.0' encoding='utf-8'%3F%3E%3Csvg version='1.2' baseProfile='tiny' id='classified-bar' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' x='0px' y='0px' viewBox='0 0 10 50' overflow='visible' xml:space='preserve'%3E%3Cpolygon points='5,50 0,50 5,25 0,0 5,0 10,25 '/%3E%3C/svg%3E%0A");
            mask-image: url("data:image/svg+xml,%3C%3Fxml version='1.0' encoding='utf-8'%3F%3E%3Csvg version='1.2' baseProfile='tiny' id='classified-bar' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' x='0px' y='0px' viewBox='0 0 10 50' overflow='visible' xml:space='preserve'%3E%3Cpolygon points='5,50 0,50 5,25 0,0 5,0 10,25 '/%3E%3C/svg%3E%0A");	
    -webkit-mask-repeat: no-repeat;	
            mask-repeat: no-repeat;
    -webkit-mask-position: center center;
            mask-position: center center;
    display: none;
    width: 0;
    min-width: 1em;
    height: -webkit-calc(100% - 0.5em);
    height: -moz-calc(100% - 0.5em);
    height: calc(100% - 0.5em);
}

div.image-space {
    margin-left: -0.35em;
    display: none;
}

/* display depending on level 0 */
div.class1image[data-level="lv0"] {
    min-width: 0;
    background-image: 
    	-webkit-linear-gradient(315deg, 
    		transparent 25%, 
    		var(--woedbar-lvl2-color) 25%, 
    		var(--woedbar-lvl2-color) 50%, 
    		transparent 50%, 
    		transparent 75%, 
    		var(--woedbar-lvl2-color) 75%, 
    		var(--woedbar-lvl2-color) 100%);
    background-image: 
    	-moz-linear-gradient(315deg, 
    		transparent 25%, 
    		var(--woedbar-lvl2-color) 25%, 
    		var(--woedbar-lvl2-color) 50%, 
    		transparent 50%, 
    		transparent 75%, 
    		var(--woedbar-lvl2-color) 75%, 
    		var(--woedbar-lvl2-color) 100%);
    background-image: 
    	-o-linear-gradient(315deg, 
    		transparent 25%, 
    		var(--woedbar-lvl2-color) 25%, 
    		var(--woedbar-lvl2-color) 50%, 
    		transparent 50%, 
    		transparent 75%, 
    		var(--woedbar-lvl2-color) 75%, 
    		var(--woedbar-lvl2-color) 100%);
    background-image: 
    	linear-gradient(135deg, 
    		transparent 25%, 
    		var(--woedbar-lvl2-color) 25%, 
    		var(--woedbar-lvl2-color) 50%, 
    		transparent 50%, 
    		transparent 75%, 
    		var(--woedbar-lvl2-color) 75%, 
    		var(--woedbar-lvl2-color) 100%);
    -webkit-background-size: 5px 5px;
       -moz-background-size: 5px 5px;
         -o-background-size: 5px 5px;
            background-size: 5px 5px;
    padding-right: 0.25em;
}

/* display depending on level */
div.class1image[data-level="lv1"] div:nth-child(-n+2) {
    display: inline-block;
    margin-left: initial;
}

div.class1image[data-level="lv2"] div:nth-child(-n+4) {
    display: inline-block;
}

div.class1image[data-level="lv3"] div:nth-child(-n+6) {
    display: inline-block;
}

div.class1image[data-level="lv4"] div:nth-child(-n+8) {
    display: inline-block;
}

div.class1image[data-level="lv5"] div:nth-child(-n+10) {
    display: inline-block;
}

div.class1image[data-level="lv6"] div:nth-child(-n+12) {
    display: inline-block;
}

/* color depending on level */
div.class1image div.classified-bar:nth-of-type(1) {
    background-color: var(--woedbar-lvl1-color);
}

div.class1image div.classified-bar:nth-of-type(3) {
    background-color: var(--woedbar-lvl2-color);
}

div.class1image div.classified-bar:nth-of-type(5) {
    background-color: var(--woedbar-lvl3-color);
}

div.class1image div.classified-bar:nth-of-type(7) {
    background-color: var(--woedbar-lvl4-color);
}

div.class1image div.classified-bar:nth-of-type(9) {
    background-color: var(--woedbar-lvl5-color);
}

div.class1image div.classified-bar:nth-of-type(11) {
    background-color: var(--woedbar-lvl6-color);
}

div.classified-bar img.sizing-image {
    width: 100%;
    height: 100%;
    visibility: hidden;
}

div.item1 {
    -ms-grid-row: 1;
    -ms-grid-column: 3;
    grid-area: item;
    white-space: nowrap;
    text-align: right;
    display: -ms-grid;
    display: grid;
        grid-template-areas:
    	"." 
    	"itemnum" 
    	"objclass" 
    	".";
    -ms-grid-rows: 
    	auto 
    	min-content 
    	min-content 
    	auto;
    grid-template-rows: 
    	auto 
    	-webkit-min-content 
    	-webkit-min-content 
    	auto;
    grid-template-rows: 
    	auto 
    	min-content 
    	min-content 
    	auto;
}

div.item1 > div {
    color: rgb(var(--swatch-menubg-dark-color, 12, 12, 12));
    font-family: rift, sans-serif, Arial, "游明朝", YuMincho, "ヒラギノ明朝 ProN W3", "Hiragino Mincho ProN", "HG明朝E", "ＭＳ Ｐ明朝", "ＭＳ 明朝", 'Noto Serif KR', serif;
    font-size: 2em;
    font-weight: normal;
    text-align: center;
    line-height: 1;
}

.PL div>span {
    font-size: 0.75em;
}

.ES div>span {
    font-size: 0.85em;
}

div.item1 .PL-top {
    font-size: 1rem;
}

div.item1 .PL-btm {
    font-size: 2rem;
}

div.itemnum {
    -ms-grid-row: 2;
    -ms-grid-column: 1;
    grid-area: itemnum;
}

div.itemnum.TH {
    line-height: 1.5;
    margin-top: -0.5em;
}

div.objclass {
    -ms-grid-row: 3;
    -ms-grid-column: 1;
    --bar-color: var(--swatch-menubg-black-color, 12, 12, 12);
    grid-area: objclass;
    position: relative;
    -webkit-box-flex: 2 !important;
    -webkit-flex-grow: 2 !important;
       -moz-box-flex: 2 !important;
        -ms-flex-positive: 2 !important;
            flex-grow: 2 !important;
    display: -webkit-box;
    display: -webkit-flex;
    display: -moz-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-align: center;
    -webkit-align-items: center;
       -moz-box-align: center;
        -ms-flex-align: center;
            align-items: center;
}
/* Bar Styling */
div.objclass::before {
    --mask-url: url("data:image/svg+xml,%3C%3Fxml version='1.0' encoding='utf-8'%3F%3E%3Csvg version='1.2' baseProfile='tiny' id='scp-general' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' x='0px' y='0px' viewBox='0 0 144 144' overflow='visible' xml:space='preserve'%3E%3Cg%3E%3Cpath d='M66.9998779,47.4119873V32.095459C47.1456299,34.559021,31.7750854,51.4788208,31.7750854,72 c0,5.5440063,1.1221924,10.8257446,3.1508179,15.6313477l13.2803345-7.6671753l-3.7330322-6.4658203L72,72L59.5341797,47.4119873 H66.9998779z'/%3E%3Cpath d='M53.2062378,88.6243896l-13.2688599,7.6604614C47.2828369,105.9677124,58.9088745,112.2249756,72,112.2249756 s24.7172241-6.2572021,32.0626831-15.9400635l-13.2688599-7.6606445l-3.7328491,6.4655151L72,72L56.9390259,95.0897827 L53.2062378,88.6243896z'/%3E%3Cpath d='M76.9998779,32.095459v15.3165283h7.4659424L72,72l27.5267944,1.4983521l-3.7330322,6.4657593l13.2803955,7.6672363 c2.0286255-4.805603,3.1508179-10.0873413,3.1508179-15.6313477C112.2249756,51.4787598,96.854248,34.55896,76.9998779,32.095459z' /%3E%3Cpath d='M72,0C32.2355347,0,0,32.2355347,0,72c0,39.7645264,32.2355347,72,72,72c39.7645264,0,72-32.2354736,72-72 C144,32.2355347,111.7645264,0,72,0z M121.6561279,106.4422607l-7.1643677-4.1362305 C105.0106812,115.5609741,89.5029907,124.2249756,72,124.2249756s-33.0106812-8.6640625-42.4917603-21.9190674 l-7.1646118,4.1363525l-5-8.6601562l7.1509399-4.128479C21.4731445,87.0516357,19.7750854,79.7225342,19.7750854,72 c0-27.1099243,20.7654419-49.4542847,47.2247925-51.9801636v-8.2445679h10v8.2445679 C103.4594116,22.5455933,124.2249756,44.8900146,124.2249756,72c0,7.7225342-1.6981201,15.0516968-4.7195435,21.6537476 l7.1506958,4.1283569L121.6561279,106.4422607z'/%3E%3C/g%3E%3C/svg%3E%0A");
    content: "";
    background-color: rgb(var(--bar-color));
    -webkit-mask-image: var(--mask-url);
            mask-image: var(--mask-url);
    -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
    -webkit-mask-size: contain;
            mask-size: contain;
    width: 1.5em;
    height: 1.5em;
    position: absolute;
    left: 0;
}

div.obj {
    color: rgb(var(--swatch-menutxt-light-color, 256, 256, 256));
    width: 100%;
    height: 1.5em;
    right: 0;
    -webkit-border-radius: 0.75em;
       -moz-border-radius: 0.75em;
            border-radius: 0.75em;
    line-height: 1;
    background-color: rgb(var(--swatch-menubg-black-color, 12, 12, 12));
    -webkit-background-size: cover;
       -moz-background-size: cover;
         -o-background-size: cover;
            background-size: cover;
    background-position: -0.03em;
    -webkit-mask: -webkit-radial-gradient(0.75em center, circle, transparent 0.85em, #000 -webkit-calc(0.85em + 1px) 100%) 50% 50%/100% 100% no-repeat;
            mask: radial-gradient(circle at 0.75em center, transparent 0.85em, #000 -moz-calc(0.85em + 1px) 100%) 50% 50%/100% 100% no-repeat;
            mask: radial-gradient(circle at 0.75em center, transparent 0.85em, #000 calc(0.85em + 1px) 100%) 50% 50%/100% 100% no-repeat;
    position: relative;
}
