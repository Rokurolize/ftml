<div class="credit first">
<p>
<strong>
T"SCP-2664"
</strong>
T": Redline"
</p>
<p>
<strong>
T"Author:"
</strong>
T" "
<span class="printuser avatarhover">
<a href="/user:info/a-random-day" onclick="WIKIDOT.page.listeners.userInfo(0); return false;">
<img class="small" src="data:image/png;base64," alt="a random day" style="background-image:url(http://www.wikidot.com/userkarma.php?u=0)">
