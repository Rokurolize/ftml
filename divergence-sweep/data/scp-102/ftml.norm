<a href="/user:info/xexnoncores" onclick="WIKIDOT.page.listeners.userInfo(0); return false;">
T"xexnoncores"
</a>
</span>
T", "
<span class="printuser avatarhover">
<a href="/user:info/tyrastafr" onclick="WIKIDOT.page.listeners.userInfo(0); return false;">
<img class="small" src="data:image/png;base64," alt="tyrastafr" style="background-image:url(http://www.wikidot.com/userkarma.php?u=0)">
