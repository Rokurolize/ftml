<span style="white-space: pre-wrap;">
T" File "/SCP/2753/files/_display.py", line 21, in respond"
</span>
</tt>
<br>
T" "
<tt>
<span style="white-space: pre-wrap;">
T" table.open.body = self.handler()"
</span>
</tt>
<br>
T" "
<tt>
<span style="white-space: pre-wrap;">
T" File "/SCP/2753/files/_display.py", line 14, in __call__"
</span>
</tt>
<br>
T" "
<tt>
<span style="white-space: pre-wrap;">
T" return self.callable(*self.args, **self.kwargs)"
</span>
</tt>
<br>
T" "
<tt>
<span style="white-space: pre-wrap;">
T" File "error_classic.py", line 7 in index"
</span>
</tt>
<br>
T" "
<tt>
<span style="white-space: pre-wrap;">
T" raise NotImplementedError(msg)"
</span>
</tt>
<br>
T" "
<tt>
<span style="white-space: pre-wrap;">
T"NotImplementedError:"
</span>
T" ["
<a href="/scp-2747">
T"DATA LOST"
</a>
T"]"
</tt>
</span>
</p>
</div>
<blockquote>
<p>
<strong>
T"NOTE:"
</strong>
T" The IntSCPFN network has experienced a critical error. If you are seeing this message, please immediately notify your Site-Director via phone, radio, or in person."
</p>
</blockquote>
<p>
<em>
<span style="color: white">
T"WE ALL"
</span>
</em>
</p>
<p>
<em>
<span style="color: white">
T"FALL"
</span>
</em>
</p>
<p>
<em>
<span style="color: white">
