[[module CSS]]
@import url('https://fonts.googleapis.com/css2?family=Zen+Old+Mincho&display=swap');
@import url('https://fonts.googleapis.com/css2?family=WDXL+Lubrifont+JP+N&display=swap');
@import url(https://fonts.googleapis.com/earlyaccess/sawarabimincho.css);
@import url(https://fonts.googleapis.com/earlyaccess/hannari.css);
@import url(https://fonts.googleapis.com/earlyaccess/roundedmplus1c.css);
@import url(https://fonts.googleapis.com/earlyaccess/kokoro.css);

.4000jp {
    font-family: 'Zen Old Mincho', 'Sawarabi Mincho', 'HG明朝B', 'HG明朝E', 'MS PMincho', 'MS Mincho', 'Hiragino Mincho ProN', selif;
    font-weight: bold;
    font-size:1.6em;
}

.bewitch {
    font-family: 'WDXL Lubrifont JP N', sanselif;
    font-size: 1.2em;
}

.hebi {
    font-family: 'Hannari', 'Sawarabi Mincho', 'HG明朝B', 'HG明朝E', 'MS PMincho', 'MS Mincho', 'Hiragino Mincho ProN', cursive, selif;
    font-smooth: always;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-weight: 700;
    font-size:1.1em;
}

p, li {
    line-height: 150%;
}

.ruby {
    vertical-align: calc(1em - 0.4px);
}

@media (max-width: 707px) {
#page-content { font-size: 0.8rem; }

}


/* Div styles per act */

.addendumBox {
    margin: 10px 0;
    padding: 3% 4% 3% 4%;
    background-color: #f9f9f9;
    color: #3e3434;
   border-radius: 20px;
   border-width: 0px 0px 0px 10px;
   border-style: solid;
   border-color: #d9d9d9 #d9d9d9 #d9d9d9 #993a3a;
  font-size: 1.1em;
}

.addendumBox2 {
    margin: 10px 0;
    padding: 3% 4% 3% 4%;
    background-color: #f9f9f9;
    color: #3e3434;
   border-radius: 20px;
   border-width: 0px 10px 0px 0px;
   border-style: solid;
   border-color: #993a3a #993a3a #993a3a #d9d9d9;
  font-size: 1.1em;
}

.addendumBox3 {
    margin: 10px 0;
    padding: 3% 4% 3% 4%;
    background-color: #f9f9f9;
    color: #3e3434;
   border-radius: 20px;
   border-width: 10px 0px 10px 0px;
   border-style: solid;
   border-color: #d9d9d9 #993a3a #d9d9d9 #993a3a;
  font-size: 1.1em;
}

.addendumBox tt {
  color: #595553;
}

.addendumBox2 tt {
  color: #595553;
}

.addendumBox3 tt {
  color: #595553;
}

.SH-Box {
   border:solid 2px #112211;
   background:#DDEEDD;
   padding:25px;
   margin-bottom: 25px;
}

.SH-Box a {
  color: #059400;
}

.SH-Box a.newpage {
  color: #00a862;
}

.admin{
  -webkit-text-stroke: 0.5px #333;
   color: green;
}

/* Mobile sizing */

@media (min-width: 0px) and (max-width: 590px) {

.mobileHeaderWidth { display: initial; }
.desktopHeaderWidth { display: none; }

  .dropcapParagraph {clear:none !important;}

  .addendumBox {
    margin: 0;
    width: 100vw;
    position: relative;
    left: -6vw;
  }

  .addendumBox2 {
    margin: 0;
    width: 100vw;
    position: relative;
    left: -4vw;
  }

  .addendumBox3 {
    margin: 0;
    width: 100vw;
    position: relative;
    left: -4vw;
  }

.SH-Box {
   padding:10px;
   margin: 0;
    width: 100vw;
    position: relative;
    left: -2.5vw;
}

}

div.dc:first-letter {
font-size:2.8em;
float:left;
padding:0 .1em;
line-height:1;
font-family: 'Sawarabi Mincho', 'HG明朝B', 'HG明朝E', 'MS PMincho', 'MS Mincho', 'Hiragino Mincho ProN', selif;
  -webkit-text-stroke: 1px black;
   color: white;
   text-shadow:
       3px 3px 0 rgb(144,57,3),
     -1px -1px 0 rgb(144,57,3),  
      1px -1px 0 rgb(144,57,3),
      -1px 1px 0 rgb(144,57,3),
       1px 1px 0 rgb(144,57,3);
}


/* footnote by 7happy7 */
span:not([class]):not([style]) > sup.footnoteref:first-child > a.footnoteref:before,
sup.footnoteref > a.footnoteref:before {
content: "(";
}
span:not([class]):not([style]) > sup.footnoteref > a.footnoteref:before {
content: ",";
}

.imageFrame {
  box-sizing: border-box;
  list-style-type: none;
  position: relative;
  float: left;
  width: auto;
  margin: 1em 1em 1em 0.5em;
  padding: 0.5em 0.5em 1px;
  border: 1px solid #c8c8c8;
  background: -webkit-linear-gradient(285deg, #f0f0f0 0%, #fff 2%, #fff 8%, rgba(255, 255, 255, 0.69) 18%, rgba(255, 255, 255, 0.19) 34%, rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.06) 51%, rgba(255, 255, 255, 0.14) 66%, rgba(255, 255, 255, 0.27) 93%, #f0f0f0 99%), url("https://scp-jp-storage.wdfiles.com/local--files/file%3A4053112-30-6su1/clearPaper.png");
  background: -moz-linear-gradient(285deg, #f0f0f0 0%, #fff 2%, #fff 8%, rgba(255, 255, 255, 0.69) 18%, rgba(255, 255, 255, 0.19) 34%, rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.06) 51%, rgba(255, 255, 255, 0.14) 66%, rgba(255, 255, 255, 0.27) 93%, #f0f0f0 99%), url("https://scp-jp-storage.wdfiles.com/local--files/file%3A4053112-30-6su1/clearPaper.png");
  background: -o-linear-gradient(285deg, #f0f0f0 0%, #fff 2%, #fff 8%, rgba(255, 255, 255, 0.69) 18%, rgba(255, 255, 255, 0.19) 34%, rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.06) 51%, rgba(255, 255, 255, 0.14) 66%, rgba(255, 255, 255, 0.27) 93%, #f0f0f0 99%), url("https://scp-jp-storage.wdfiles.com/local--files/file%3A4053112-30-6su1/clearPaper.png");
  background: -ms-linear-gradient(285deg, #f0f0f0 0%, #fff 2%, #fff 8%, rgba(255, 255, 255, 0.69) 18%, rgba(255, 255, 255, 0.19) 34%, rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.06) 51%, rgba(255, 255, 255, 0.14) 66%, rgba(255, 255, 255, 0.27) 93%, #f0f0f0 99%), url("https://scp-jp-storage.wdfiles.com/local--files/file%3A4053112-30-6su1/clearPaper.png");
  background: linear-gradient(165deg, #f0f0f0 0%, #fff 2%, #fff 8%, rgba(255, 255, 255, 0.69) 18%, rgba(255, 255, 255, 0.19) 34%, rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.06) 51%, rgba(255, 255, 255, 0.14) 66%, rgba(255, 255, 255, 0.27) 93%, #f0f0f0 99%), url("https://scp-jp-storage.wdfiles.com/local--files/file%3A4053112-30-6su1/clearPaper.png");
  box-shadow: 0.25em 0.25em rgba(240, 240, 240, 0.8);
}

.imageFrame.right {
  float: right;
  margin: 1em 0.5em 1em 1em;
}

.imageFrame.center {
  float: none;
  clear: both;
  margin: 1em auto;
}

.imageFrame:before {
  position: absolute;
  background-repeat: no-repeat;
  content: "";
}

.imageFrame p {
  margin: 0 0 0.6em;
  text-align: center;
  line-height: 0.7;
}

.imageFrame hr {
  width: 80%;
  margin: 0 auto 0.3em;
}

@media (max-width: 768px) {
.imageFrame {
  box-sizing: border-box;
  list-style-type: none;
  position: relative;
  width: auto;
  padding: 0.5em 0.5em 1px;
  border: 1px solid #c8c8c8;
  background: -webkit-linear-gradient(285deg, #f0f0f0 0%, #fff 2%, #fff 8%, rgba(255, 255, 255, 0.69) 18%, rgba(255, 255, 255, 0.19) 34%, rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.06) 51%, rgba(255, 255, 255, 0.14) 66%, rgba(255, 255, 255, 0.27) 93%, #f0f0f0 99%), url("https://scp-jp-storage.wdfiles.com/local--files/file%3A4053112-30-6su1/clearPaper.png");
  background: -moz-linear-gradient(285deg, #f0f0f0 0%, #fff 2%, #fff 8%, rgba(255, 255, 255, 0.69) 18%, rgba(255, 255, 255, 0.19) 34%, rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.06) 51%, rgba(255, 255, 255, 0.14) 66%, rgba(255, 255, 255, 0.27) 93%, #f0f0f0 99%), url("https://scp-jp-storage.wdfiles.com/local--files/file%3A4053112-30-6su1/clearPaper.png");
  background: -o-linear-gradient(285deg, #f0f0f0 0%, #fff 2%, #fff 8%, rgba(255, 255, 255, 0.69) 18%, rgba(255, 255, 255, 0.19) 34%, rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.06) 51%, rgba(255, 255, 255, 0.14) 66%, rgba(255, 255, 255, 0.27) 93%, #f0f0f0 99%), url("https://scp-jp-storage.wdfiles.com/local--files/file%3A4053112-30-6su1/clearPaper.png");
  background: -ms-linear-gradient(285deg, #f0f0f0 0%, #fff 2%, #fff 8%, rgba(255, 255, 255, 0.69) 18%, rgba(255, 255, 255, 0.19) 34%, rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.06) 51%, rgba(255, 255, 255, 0.14) 66%, rgba(255, 255, 255, 0.27) 93%, #f0f0f0 99%), url("https://scp-jp-storage.wdfiles.com/local--files/file%3A4053112-30-6su1/clearPaper.png");
  background: linear-gradient(165deg, #f0f0f0 0%, #fff 2%, #fff 8%, rgba(255, 255, 255, 0.69) 18%, rgba(255, 255, 255, 0.19) 34%, rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.06) 51%, rgba(255, 255, 255, 0.14) 66%, rgba(255, 255, 255, 0.27) 93%, #f0f0f0 99%), url("https://scp-jp-storage.wdfiles.com/local--files/file%3A4053112-30-6su1/clearPaper.png");
  box-shadow: 0.25em 0.25em rgba(240, 240, 240, 0.8);
    display: block;
    float: none;
    clear: both;
    margin-left: auto;
    margin-right: auto;
  }
}

/* ---- PAGE RATING ---- */
 
div.page-rate-widget-box {
    border-radius: 0;
}
div.page-rate-widget-box .rate-points {
    border-radius: 0;
}
 
.page-rate-widget-box .cancel {
    border-radius: 0;
}
 
.rate-box-with-credit-button .creditButton {
    border-radius: 0;
}
 
.modalbox {
    border-radius: 0;
}
 
.modalbox .modalbox-title {
    border-radius: 0;
}
 
.rateBox .rate-box-with-credit-button .creditButton {
    border-radius: 0;
}

.text-fade {
    -webkit-mask-image: linear-gradient(to right, rgb(0,0,0,1), rgba(0,0,0,0) 100%);
}

.hovertip .content div:nth-child(3) {
color:transparent;
   -ms-user-select: none; /* IE 10+ */
   -moz-user-select: -moz-none;
   -khtml-user-select: none;
   -webkit-user-select: none;
   user-select: none;
position:relative;
}
.hovertip .content div:nth-child(3):after {
content:"(click to scroll to footnotes)";
color:#222;
position:absolute;
top:0;
left:0;
display:block;
}

.viewport {
  position: relative;
  overflow: hidden;
}
.viewport::before {
  content: "";
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  z-index: 2;
  pointer-events: none;
  animation: lines 0.1s infinite;
  background-size: 100% 3px, 2px 100%;
}

@keyframes lines {
  0% {
    background-image: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0) 0px, rgba(0, 0, 0, 0) 2px, rgba(0, 0, 0, 0.3) 3px);
  }
  50% {
    background-image: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.3) 0px, rgba(0, 0, 0, 0) 1px, rgba(0, 0, 0, 0) 3px);
  }
  100% {
    background-image: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0) 0px, rgba(0, 0, 0, 0) 2px, rgba(0, 0, 0, 0.3) 3px);
  }
}

[[/module]]


[[module css]]
div[class*="award"] + .creditRate .creditButton .fa.fa-info:before {
content: "\f091";
color: #fff!important;
}
div.award-1st ~ #u-credit-otherwise .credit.otherwise .contest {
background-image: linear-gradient(349deg, #F7DE05, #DA8E00, #EDAC06, #F7DE05, #ECB802, #DAAF08, #B67B03);
}
div.award-elec ~ #u-credit-otherwise .credit.otherwise .contest {
background-image: linear-gradient(349deg, #A5A5A5, #BABAC2, #E8E8E8, #A5A5A5, #BABAC2);
}
div.award-cop ~ #u-credit-otherwise .credit.otherwise .contest {
background-image: linear-gradient(349deg, rgba(229,138,61,.9), rgba(217,139,43,.9), rgba(168,80,21,.9), rgba(260,164,79,.9));
}
div[class*="award"] ~ #u-credit-otherwise .credit.otherwise .contest {
border: 1px solid transparent;
border-radius: 1px;
text-shadow: 1px 2px 3px rgba(0,0,0,0.35);
}
div[class*="award"] ~ #u-credit-otherwise .credit.otherwise .contest a {
background-color: transparent!important;
color: #fff!important;
font-weight: bold;
transition: text-shadow 0.3s;
}
div[class*="award"] ~ #u-credit-otherwise .creditButton a:hover,
div[class*="award"] ~ #u-credit-otherwise .credit.otherwise .contest a:hover {
text-decoration: none;
text-shadow: 1px 2px 5px rgba(255,255,255,0.9);
}
div[class*="award"] ~ #u-credit-otherwise .credit.otherwise .contest {
border-radius: 2px;
border-width: 2px;
color: #fff;
font-family: BauhausLTDemi,Arial,sans-serif;
font-size: 110%;
margin: 0 0.3em;
text-align: center;
text-shadow: 3px 3px 5px #000;
}
div[class*="award"] ~ #u-credit-otherwise .credit.otherwise .contest {
border-radius: 2px;
border-width: 2px;
color: #fff;
font-family: BauhausLTDemi,Arial,sans-serif;
font-size: 110%;
margin: 0 0.3em;
text-align: center;
text-shadow: 3px 3px 5px #000;
}
div.award-1st ~ #u-credit-otherwise .credit.otherwise .contest span:before,
div.award-1st ~ #u-credit-otherwise .credit.otherwise .contest span:after {
content: "\f091";
display: inline-block;
font: normal normal normal 14px/1 FontAwesome;
text-rendering: auto;
-webkit-font-smoothing: antialiased;
-moz-osx-font-smoothing: grayscale;
margin: 0.3em;
}
div[class*="award"] ~ #u-credit-otherwise .contest {
cursor: pointer;
}
div[class*="award"] ~ #u-credit-otherwise .contest p span {
transition: font-size 0.6s 0.2s;
text-rendering: auto;
-webkit-font-smoothing: antialiased;
-moz-osx-font-smoothing: grayscale;
}
div[class*="award"] ~ #u-credit-otherwise .contest p a,
div[class*="award"] ~ #u-credit-otherwise .contest:hover p span {
font-size: 1.1em;
}
div[class*="award"] ~ #u-credit-otherwise .contest p span {
cursor: auto;
}

/*
border-image is created by Woedenaz
https://wanderers-library.wikidot.com/component:dustjacket-theme
CC BY-SA 3.0
*/
div[class*="award"] ~ #u-credit-otherwise .modalbox {
box-sizing: border-box;
border: 2ex solid rgba(0,0,0,0.5);
border-image: url("https://scp-jp.wdfiles.com/local--files/component%3Acredit-top-sp/gold.png") 475 round;
border-image-width: 6;
background: radial-gradient(rgba(255, 219, 90, 0.95) 0, #fff 100%);
background: -webkit-radial-gradient(rgba(255, 219, 90, 0.95) 0, #fff 100%);
}
div.award-elec ~ #u-credit-otherwise .modalbox {
    background: radial-gradient(rgba(165, 205, 205, 0.95) 0, #fff 100%);
    background: -webkit-radial-gradient(rgba(165, 205, 205, 0.95) 0, #fff 100%);
    filter: grayscale(75%);
}
div.award-cop ~ #u-credit-otherwise .modalbox {
    background: radial-gradient(rgba(205, 205, 165, 0.95) 0, #fff 100%);
    background: -webkit-radial-gradient(rgba(205, 205, 165, 0.95) 0, #fff 100%);
    filter: grayscale(45%);
}
div[class*="award"] ~ #u-credit-otherwise .modalbox .modalbox-title {
background: transparent;
}
div[class*="award"] ~ #u-credit-otherwise .modalbox .modalbox-title h2 {
color: #fff;
text-shadow: 1px 1px 3px rgba(221, 102, 17, 0.5), 1px -1px 3px rgba(221, 102, 17, 0.5), -1px 1px 3px rgba(221, 102, 17, 0.5), -1px -1px 3px rgba(221, 102, 17, 0.5);
font-weight: bold;
}
div[class*="award"] ~ #u-credit-otherwise .modalbox .credit.otherwise {
overflow: auto;
}
[[/module]]
[[div_ class="award-1st"]]
[[/div]]

