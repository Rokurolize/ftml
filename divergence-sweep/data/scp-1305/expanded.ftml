    		-ms-flex-direction: column;
    			flex-direction: column;
    width: 100%;
    	max-width: 48vw;
    	margin: 0 0 0 -0.15rem;
    height: 3rem;
    }

    .top-right-box > div {
    	line-height: 1;
    }

    .top-right-box > .level {
