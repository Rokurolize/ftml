));" data-variable="--very-light-gray-monochrome
" data-has-light-text="{$subcolor1-has-light-text}"]]
Alto
[[span class="css-variable"]]@@--very-light-gray-monochrome
@@[[/span]][[span class="css-variable"]](215, 215, 215)
[[/span]]
[[/div]]
[[div_ class="color" style="background-color: rgb(var(--pale-gray-monochrome
));" data-variable="--pale-gray-monochrome
" data-has-light-text="{$subcolor2-has-light-text}"]]
