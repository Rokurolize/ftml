>[[ift{$ashes}gs -theme]]
>[[iftags]]
[[module CSS]]
/* BOOK OF ASHES */
 :root {
    --accentColor: hsl(360, 65%, 65%);
    --accentColorLite: hsla(360, 65%, 75%, .5);
    --hue: 360deg;

    --bgColor: hsl(360, 6%, 21%);
    --fgColor: hsl(360, 8%, 15%);
}

 #header h1 a::after {
    content: "BOOK OF ASHES";
}
[[/module]]
>[[/iftags]]
>[[/ift{$ashes}gs]]


>[[ift{$light}gs -theme]]
>[[iftags]]
[[module CSS]]
/* BOOK OF LIGHT */
 :root {
    --accentColor: hsl(45, 50%, 50%);
    --accentColorLite: hsla(45, 50%, 60%, .5);
    --hue: 45deg;

    --bgColor: hsl(45, 1.5%, 21%);
    --fgColor: hsl(45, 2%, 15%);
}

 #header h1 a::after {
    content: "BOOK OF LIGHT";
}
[[/module]]
>[[/iftags]]
>[[/ift{$light}gs]]


>[[ift{$veldt}gs -theme]]
>[[iftags]]
[[module CSS]]
/* NOTES FROM THE GREEN YONDER */
 :root {
    --accentColor: hsl(135, 55%, 55%);
    --accentColorLite: hsla(135, 55%, 65%, .5);
    --hue: 135deg;

    --bgColor: hsl(135, 3%, 21%);
    --fgColor: hsl(135, 4%, 15%);
}

 #header h1 a::after {
    content: "FROM THE GREEN YONDER";
    margin-top: -2.25em;

    font: 1.067rem/0 var(--header-font);
}

 @media (max-width: 575.9px) {
     #header h1 a::after {
    	content: "THE GREEN YONDER";
    }
}
[[/module]]
>[[/iftags]]
>[[/ift{$veldt}gs]]


>[[ift{$loose-threads}gs -theme]]
>[[iftags]]
[[module CSS]]
/* LOOSE THREADS */
 :root {
    --accentColor: hsl(225, 65%, 65%);
    --accentColorLite: hsla(225, 65%, 75%, .5);
    --hue: 225deg;

    --bgColor: hsl(225, 6%, 21%);
    --fgColor: hsl(225, 8%, 15%);
}

 #header h1 a::after {
    content: "LOOSE THREADS";
}
[[/module]]
>[[/iftags]]
>[[/ift{$loose-threads}gs]]


