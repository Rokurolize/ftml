[[/div]]
[[div_ class="acs-extra-3" style="background-color: rgba({$class-color-3},0.15); border-left: 0.5rem solid rgba({$class-color-3},1);"]]
[[div_ class="class-category"]]
{$class-category-3}
[[/div]]
[[div_ class="class-text"]]
