    	display: -webkit-flex;
    	display: -moz-box;
    	display: -ms-flexbox;
    	display: flex;
    }

@media (max-width: 480px ) {
    	.anom-bar > .top-box {
    		height: 6rem;
    		display: -webkit-box;
    		display: -webkit-flex;
    		display: -moz-box;
    		display: -ms-flexbox;
    		display: flex;
    		-webkit-box-orient: vertical;
