<div class="credit first">
<p>
<strong>
T"SCP-910:"
</strong>
T" Dust, Embodied"
<br>
T" "
<strong>
T"Author:"
</strong>
T" "
<span class="printuser avatarhover">
<a href="/user:info/pedantique" onclick="WIKIDOT.page.listeners.userInfo(0); return false;">
<img class="small" src="data:image/png;base64," alt="pedantique" style="background-image:url(http://www.wikidot.com/userkarma.php?u=0)">
