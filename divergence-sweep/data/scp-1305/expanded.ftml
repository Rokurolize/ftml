}

.anom-bar-container:not(.esoteric) .danger-diamond > .bottom-icon {
    display: none;
}

.danger-diamond > .top-icon::before,
.danger-diamond > .right-icon::before,
.danger-diamond > .left-icon::before,
.danger-diamond > .bottom-icon::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
